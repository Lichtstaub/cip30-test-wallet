{
  "name": "cip30-test-wallet",
  "version": "0.4.0",
  "description": "CIP-30 test wallet for Cardano dApps. Injects into Playwright tests and signs real transactions and messages with no wallet popup, so CI and coding agents can test wallet flows unattended. Includes a quirk catalogue and a CSP doctor.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lichtstaub/cip30-test-wallet.git"
  },
  "bugs": {
    "url": "https://github.com/Lichtstaub/cip30-test-wallet/issues"
  },
  "homepage": "https://github.com/Lichtstaub/cip30-test-wallet#readme",
  "keywords": [
    "cardano",
    "cip30",
    "cip-30",
    "wallet",
    "playwright",
    "testing",
    "dapp",
    "e2e",
    "ci",
    "ai-agents",
    "coding-agents"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  },
  "main": "./dist/node/index.js",
  "types": "./dist/node/index.d.ts",
  "bin": {
    "cip30-test-wallet": "dist/node/cli/doctor.js"
  },
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./playwright": {
      "types": "./dist/node/playwright/index.d.ts",
      "default": "./dist/node/playwright/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "quirks",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && playwright test",
    "serve:demo": "node examples/minimal-dapp/serve.mjs",
    "doctor:demo": "npm run build && node scripts/doctor-demo.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "bundle:check": "node scripts/bundle-check.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "prepare": "node scripts/build.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run bundle:check"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.0.0",
    "@scure/bip39": "^2.4.0"
  },
  "devDependencies": {
    "@emurgo/cardano-message-signing-nodejs": "^1.1.0",
    "@emurgo/cardano-serialization-lib-nodejs": "^17.0.0",
    "@evolution-sdk/evolution": "^0.5.9",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
