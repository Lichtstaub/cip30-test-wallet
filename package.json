{
  "name": "cardano-headless-wallet",
  "version": "0.1.0-alpha.0",
  "description": "Headless CIP-30 wallet for automated Cardano dApp transaction tests, with a catalogue of real wallet quirks.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "main": "./dist/node/index.js",
  "types": "./dist/node/index.d.ts",
  "exports": {
    ".": { "types": "./dist/node/index.d.ts", "default": "./dist/node/index.js" },
    "./playwright": { "types": "./dist/node/playwright/index.d.ts", "default": "./dist/node/playwright/index.js" }
  },
  "files": ["dist", "docs", "quirks", "README.md", "LICENSE"],
  "keywords": ["cardano", "cip30", "cip-30", "wallet", "playwright", "testing", "headless", "dapp"],
  "engines": { "node": ">=20.19" },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && playwright test",
    "serve:demo": "node examples/minimal-dapp/serve.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "bundle:check": "node scripts/bundle-check.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.0.0",
    "@scure/bip39": "^2.4.0",
    "@evolution-sdk/evolution": "^0.5.9"
  },
  "devDependencies": {
    "@emurgo/cardano-serialization-lib-nodejs": "^17.0.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50"
  },
  "peerDependenciesMeta": {
    "@playwright/test": { "optional": true }
  }
}
